{
  "name": "debrief-cli",
  "version": "0.1.0",
  "description": "Local, agent-facing working memory for coding agents.",
  "keywords": [
    "claude-code",
    "mcp",
    "memory",
    "coding-agents",
    "agent-memory",
    "sqlite",
    "local-first"
  ],
  "homepage": "https://github.com/0xAysh/debrief#readme",
  "bugs": {
    "url": "https://github.com/0xAysh/debrief/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xAysh/debrief.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "debrief": "dist/debrief.mjs"
  },
  "files": [
    "dist/debrief.mjs",
    "dist/embedder.mjs",
    "dist/ort-wasm-simd-threaded.mjs",
    "dist/ort-wasm-simd-threaded.wasm",
    "dist/models/",
    "dist/ONNXRUNTIME_THIRD_PARTY_NOTICES.txt",
    "dist/THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "benchmark:import": "npm run build --silent && node scripts/benchmark-synthetic-import.mjs",
    "measure:hooks": "npm run build --silent && node scripts/measure-hook-overhead.mjs",
    "snapshot:transcripts": "node scripts/snapshot-real-transcripts.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "esbuild": "0.25.12",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "onnxruntime-web": "1.30.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}

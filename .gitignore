# Local planning documents
/PRD.md

# Local secrets (keep example configuration trackable)
.env
.env.*
!.env.example

# Node.js dependencies
node_modules/

# Build and test output
/dist/
# The embedding model and ONNX Runtime's third-party notices, fetched at build time and pinned (scripts/bundle.mjs); shipped in the package, never committed
/.cache/
/coverage/
*.tsbuildinfo

# macOS metadata
.DS_Store

# Sample outputs written by the MCP end-to-end test
/tests/mcp/__artifacts__/
# Sanitized hook payloads captured from the real hosts (evidence for the hooks support matrix)
/tests/hooks/__artifacts__/

# Local snapshot of the developer's real agent transcripts (npm run snapshot:transcripts).
# Holds account ids, file contents and credentials: never commit or push it.
/.real-transcripts/
